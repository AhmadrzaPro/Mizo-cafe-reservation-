# Copy to .dev.vars for `wrangler dev`, or set each value as a host secret/variable in production.
# Never commit real values. Every variable is optional.

# Demo mode exposes test OTPs and simulates payments. Use only in an isolated demo deployment.
# DEMO_MODE=true

# Café used for "/" when no ?cafe=<slug> is given.
# DEFAULT_CAFE_SLUG=

# Kavenegar SMS (OTP login, confirmation and reminder messages).
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
KAVENEGAR_CONFIRMATION_TEMPLATE=
KAVENEGAR_REMINDER_TEMPLATE=

# Automatic floor-map image analysis. Manual tracing works without it.
OPENAI_API_KEY=
# MAP_VISION_MODEL=gpt-4.1-mini

# SaaS console sign-in. Set to oai-header only on a host that authenticates users and sets the
# oai-authenticated-user-id/-email headers itself (Sites). Anywhere else leave it unset: the console
# stays closed, because clients could send those headers themselves.
# SAAS_ADMIN_AUTH=oai-header

# Header the proxy in front of the app sets with the client IP.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Abuse-protection limits (defaults shown).
# RATE_LIMIT_OTP_PER_IP_HOUR=10
# RATE_LIMIT_OTP_VERIFY_PER_IP_HOUR=30
# RATE_LIMIT_TRACKING_PER_IP_HOUR=30
# RATE_LIMIT_SETUP_PER_IP_DAY=5
# RATE_LIMIT_RESERVATIONS_PER_IP_HOUR=10
# MAX_ACTIVE_RESERVATIONS_PER_MOBILE=3
# SMS_DAILY_CAP_PER_CAFE=300
