{
  "name": "mizo-cafe-reservation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p . && tsc -p web",
    "format": "prettier --write worker/src web/src \"web/css/**/*.css\"",
    "format:check": "prettier --check worker/src web/src \"web/css/**/*.css\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.0.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vazirmatn": "33.0.3"
  },
  "dependencies": {
    "hono": "4.13.14",
    "zod": "4.6.7"
  }
}
