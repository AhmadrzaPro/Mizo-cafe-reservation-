{
  "name": "mizo-cafe-reservation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && node scripts/check-css.mjs",
    "typecheck": "node scripts/element-types.mjs --check && tsc -p . && tsc -p web",
    "format": "prettier --write worker/src web/src e2e \"web/css/**/*.css\"",
    "format:check": "prettier --check worker/src web/src e2e \"web/css/**/*.css\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.0.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vazirmatn": "33.0.3"
  },
  "dependencies": {
    "hono": "4.13.14",
    "three": "0.186.1",
    "zod": "4.6.7"
  }
}
